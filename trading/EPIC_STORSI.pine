//@version=6
indicator("EPIC STORSI+", shorttitle="EPIC STORSI+", overlay=false)

// ======== SETTINGS ========
storsiPeriod  = input.int(21, title="STORSI Period", minval=1, group="Calculation Settings")
maType        = input.string("SMA", title="Moving Average Type", options=["SMA", "EMA", "WMA", "HMA", "RMA"], group="Calculation Settings")
maLength      = input.int(21, title="Signal Line MA Length", minval=1, group="Calculation Settings")
triggerLength = input.int(30, title="Trigger Line MA Length", minval=1, group="Calculation Settings")

// ======== STYLE ========
showBgColor  = input.bool(true,  title="Show Background Color", group="Style Settings")
holdBg       = input.bool(true,  title="Keep color until opposite cross", group="Style Settings")
obLevel      = input.int(70,     title="Overbought Level", minval=51, maxval=100, group="Style Settings")
osLevel      = input.int(30,     title="Oversold Level",  minval=1,  maxval=49,  group="Style Settings")
epicColor    = input.color(color.new(#4CAF50, 0), title="Epic Line",   group="Style Settings", inline="line1")
signalColor  = input.color(color.new(#FF5252, 0), title="Signal Line", group="Style Settings", inline="line1")
triggerColor = input.color(color.new(#FFEB3B, 0), title="Trigger Line",group="Style Settings", inline="line2")

// ======== MA HELPER ========
f_getMA(source, length, type) =>
    switch type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "WMA" => ta.wma(source, length)
        "HMA" => ta.hma(source, length)
        => ta.rma(source, length)

// ======== CALCULATIONS ========
// RSI part
upMove   = math.max(0.0, close - close[1])
downMove = math.max(0.0, close[1] - close)
upSMA    = ta.sma(upMove, storsiPeriod)
downSMA  = ta.sma(downMove, storsiPeriod)
relativeStrength = downSMA == 0 ? 0.0 : upSMA / downSMA
rsi = 100.0 - (100.0 / (1.0 + relativeStrength))

// Stoch part
hi = ta.highest(high, storsiPeriod)
lo = ta.lowest(low, storsiPeriod)
stochastic = hi == lo ? 50.0 : (close - lo) / (hi - lo) * 100.0

// Hybrid
epicLine    = (rsi + stochastic) / 2.0
signalLine  = f_getMA(epicLine, maLength, maType)
combo       = (signalLine + epicLine) / 2.0
triggerLine = f_getMA(combo, triggerLength, maType)

// ======== PLOTS ========
plot(epicLine,    color=epicColor,   title="Epic STORSI", linewidth=2)
plot(signalLine,  color=signalColor, title="Signal Line", linewidth=2)
plot(triggerLine, color=triggerColor,title="Trigger Line", linewidth=1)
hline(obLevel, "Overbought", color=color.new(color.gray, 50), linestyle=hline.style_dashed)
hline(osLevel, "Oversold",   color=color.new(color.gray, 50), linestyle=hline.style_dashed)
hline(50,      "Mid Line",   color=color.new(color.gray, 80), linestyle=hline.style_dotted)

// ======== BACKGROUND (persistent regime) ========
crossover_bull = ta.crossover(epicLine, signalLine)
crossover_bear = ta.crossunder(epicLine, signalLine)

// 1 = bull, -1 = bear, 0 = none yet
var int regime = 0
if crossover_bull
    regime := 1
else if crossover_bear
    regime := -1

color bgCol = na
if showBgColor
    if holdBg
        bgCol := regime == 1 ? color.new(color.green, 85) :
                 regime == -1 ? color.new(color.red,   85) : na
    else
        bgCol := crossover_bull ? color.new(color.green, 85) :
                 crossover_bear ? color.new(color.red,   85) : na

bgcolor(bgCol)
